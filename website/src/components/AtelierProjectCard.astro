---
const { project, workshop = false, eager = false } = Astro.props;
const image = project.gallery[0];
const portrait = image && image.height > image.width;
const focalPoint = image?.focalPoint ? `${image.focalPoint[0]}% ${image.focalPoint[1]}%` : undefined;
---

<article class:list={["atelier-card", { "atelier-card--workshop": workshop, "atelier-card--text": !image }]}>
  {image && (
    <a class:list={["atelier-card__image", { "atelier-card__image--portrait": portrait }]}
      href={project.href} aria-label={`Read ${project.title}`} tabindex="-1">
      <img src={image.src} width={image.width} height={image.height} alt={image.alt}
        style={focalPoint ? { objectPosition: focalPoint } : undefined}
        loading={eager ? "eager" : "lazy"} decoding="async" />
    </a>
  )}
  <div class="atelier-card__copy">
    <div>
      {!workshop && <p class="atelier-eyebrow">Personal residence · Restoration</p>}
      <h3><a href={project.href}>{project.title}</a></h3>
      <p class="atelier-card__summary">{project.summary}</p>
    </div>
    <a class="atelier-card__link" href={project.href} aria-label={`Read project: ${project.title}`}>
      Read project <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .atelier-card { background: var(--atelier-card); border: 2px solid var(--atelier-ink); box-shadow: 4px 4px 0 var(--atelier-ink); display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem; padding: 2rem; }
  .atelier-card:nth-child(even) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  .atelier-card:nth-child(even) .atelier-card__image { order: 2; }
  .atelier-card--text, .atelier-card--text:nth-child(even) { grid-template-columns: minmax(0, 1fr); }
  .atelier-card__image { aspect-ratio: 16 / 10; background: #dfd6cc; border: 1px solid #b5a99a; display: block; overflow: hidden; }
  .atelier-card__image img { width: 100%; height: 100%; object-fit: cover; }
  .atelier-card__image--portrait img { object-fit: contain; }
  .atelier-card__copy { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
  .atelier-card h3 { font-family: var(--atelier-display); font-size: clamp(1.9rem, 2.7vw, 2.5rem); font-weight: 500; line-height: 1.06; margin: .5rem 0 1rem; }
  .atelier-card h3 a { text-decoration: none; }
  .atelier-card h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .atelier-card__summary { color: #4a4237; font-size: .9375rem; line-height: 1.65; margin: 0 0 2rem; max-width: 46ch; }
  .atelier-card__link { border-top: 1px solid #d5cbc0; color: var(--atelier-accent); display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding-top: .8rem; font-family: var(--atelier-mono); font-size: .75rem; text-decoration: none; }
  .atelier-card__link:hover { text-decoration: underline; }
  .atelier-card--workshop, .atelier-card--workshop:nth-child(even) { background: #1c1814; border: 1px solid #493d31; box-shadow: none; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; padding: 1.5rem; }
  .atelier-card--workshop:nth-child(even) .atelier-card__image { order: 0; }
  .atelier-card--workshop .atelier-card__image { aspect-ratio: 16 / 9; background: #2e2822; border-color: #645747; }
  .atelier-card--workshop h3 { font-size: 1.85rem; margin-top: 0; }
  .atelier-card--workshop .atelier-card__summary { color: #b5aba0; font-size: .875rem; }
  .atelier-card--workshop .atelier-card__link { border-color: #493d31; color: var(--atelier-brass); }
  @media (max-width: 56rem) {
    .atelier-card, .atelier-card:nth-child(even) { grid-template-columns: minmax(0, 1fr); }
    .atelier-card:nth-child(even) .atelier-card__image { order: 0; }
    .atelier-card h3 { font-size: 2rem; }
  }
  @media (max-width: 38rem) {
    .atelier-card { padding: 1.25rem; gap: 1.5rem; }
    .atelier-card__image { aspect-ratio: 4 / 3; }
    .atelier-card__image--portrait { aspect-ratio: 3 / 4; }
    .atelier-card--workshop { padding: 1rem; }
    .atelier-card--workshop .atelier-card__image { aspect-ratio: 1; }
    .atelier-card__summary { font-size: 1rem; }
  }
</style>
