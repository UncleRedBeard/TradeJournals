---
const { headline, intro, image, workHref } = Astro.props;
---

<section class="hero">
  <div class="shell hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Toil & Timber Restoration</p>
      <h1>{headline}</h1>
      <p>{intro}</p>
      {workHref && <a class="button-link" href={workHref}>See the work</a>}
    </div>
    {image && <img class="hero__image" src={image.src} width={image.width} height={image.height} alt={image.alt} />}
  </div>
</section>

<style>
  .hero { background: var(--green); color: var(--paper); padding: clamp(4rem, 11vw, 9rem) 0; }
  .hero__grid { align-items: end; display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.75fr); }
  .hero h1 { font-family: var(--display); font-size: clamp(3.5rem, 9vw, 7.5rem); font-weight: 400; letter-spacing: -0.05em; line-height: 0.9; margin: 0; max-width: 10ch; }
  .hero p:not(.eyebrow) { font-size: 1.1rem; max-width: 38rem; }
  .hero .eyebrow { color: var(--sage); }
  .hero__image { aspect-ratio: 1; height: auto; object-fit: cover; width: 100%; }
  @media (max-width: 48rem) { .hero__grid { grid-template-columns: 1fr; } .hero__image { max-width: 28rem; } }
</style>
