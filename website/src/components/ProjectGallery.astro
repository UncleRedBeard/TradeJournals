---
const { images } = Astro.props;
---

<div class="gallery">
  {images.map((image, index) => <figure class:list={["gallery__item", `gallery__item--${index % 5}`]}>
    <a href={image.sourceUrl} aria-label={`View original source for ${image.alt}`}><img src={image.src} width={image.width} height={image.height} alt={image.alt} loading={index === 0 ? "eager" : "lazy"} style={image.focalPoint ? `object-position: ${image.focalPoint[0]}% ${image.focalPoint[1]}%` : undefined} /></a>
    {image.caption && <figcaption>{image.caption} <a href={image.sourceUrl}>Original source</a></figcaption>}
  </figure>)}
</div>

<style>
  .gallery { display: grid; gap: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gallery__item { margin: 0; }
  .gallery__item img { aspect-ratio: 1; object-fit: cover; width: 100%; }
  .gallery__item--2, .gallery__item--4 { grid-column: span 2; }
  .gallery__item--2 img, .gallery__item--4 img { aspect-ratio: 2 / 1; }
  figcaption { color: #526258; font-size: 0.85rem; margin-top: 0.45rem; }
  @media (max-width: 38rem) { .gallery { grid-template-columns: 1fr; } .gallery__item--2, .gallery__item--4 { grid-column: auto; } .gallery__item--2 img, .gallery__item--4 img { aspect-ratio: 1; } }
</style>
