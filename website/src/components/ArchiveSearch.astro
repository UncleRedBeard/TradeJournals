---
const { projects } = Astro.props;
---

<section class="archive-search" aria-labelledby="archive-search-heading">
  <div class="archive-search__tools">
    <div>
      <h2 id="archive-search-heading">Ask the journals</h2>
      <p id="archive-search-help">Search the selected archive by room, material, or process.</p>
    </div>
    <form data-archive-search>
      <label for="archive-query">Search the archive</label>
      <div class="archive-search__field"><input id="archive-query" name="q" type="search" aria-describedby="archive-search-help" /><button type="submit">Search</button></div>
    </form>
  </div>
  <p class="archive-search__status" data-search-status aria-live="polite"></p>
  <div class="archive-search__entries" data-search-results hidden></div>
  <div class="archive-search__entries" data-archive-list>
    {projects.map(project => <article><h3><a href={project.href}>{project.title}</a></h3><p>{project.summary}</p></article>)}
  </div>
</section>

<script defer src="/scripts/journal-search.js"></script>
<script defer src="/scripts/archive-search.js"></script>

<style>
  .archive-search__tools { align-items: center; background: var(--atelier-card); border-top: 2px solid var(--atelier-brass); display: grid; gap: 1.5rem 3rem; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding: 2rem; }
  h2 { font: 500 2rem/1.1 var(--atelier-display); margin: 0 0 .65rem; }
  .archive-search__tools p { color: #4a4237; font-size: .875rem; line-height: 1.65; margin: 0; max-width: 40ch; }
  label { display: block; font: .75rem/1.5 var(--atelier-mono); margin-bottom: .5rem; }
  .archive-search__field { display: flex; gap: .5rem; }
  input { background: var(--atelier-paper); border: 1px solid #b5a99a; border-radius: 0; color: var(--atelier-ink); flex: 1; font: inherit; min-height: 48px; min-width: 0; padding: .65rem .75rem; width: 100%; }
  button { background: var(--atelier-dark); border: 1px solid var(--atelier-dark); color: var(--atelier-paper); cursor: pointer; font: inherit; min-height: 48px; padding: .65rem 1.25rem; }
  button:hover { background: #3a3027; }
  .archive-search__status { color: #4a4237; font: .8125rem/1.6 var(--atelier-mono); min-height: 1.5rem; margin: 1.25rem 0; }
  .archive-search__entries { display: grid; gap: 0 3rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .archive-search__entries[hidden] { display: none; }
  /* Search creates these descendants at runtime, without Astro scope attributes. */
  .archive-search__entries :global(article) { border-top: 1px solid var(--line); min-width: 0; padding: 1.75rem 0 2rem; }
  .archive-search__entries :global(h3) { font: 500 clamp(1.8rem, 2.5vw, 2.25rem)/1.15 var(--atelier-display); margin: 0 0 .85rem; }
  .archive-search__entries :global(h3 a) { text-decoration-thickness: 1px; text-underline-offset: .15em; }
  .archive-search__entries :global(h3 a:hover) { color: var(--atelier-accent); }
  .archive-search__entries :global(p) { color: #4a4237; font-size: .9375rem; line-height: 1.75; margin: 0; max-width: 60ch; }
  @media (max-width: 56rem) { .archive-search__tools { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 38rem) {
    .archive-search__tools { padding: 1.25rem; }
    .archive-search__entries { grid-template-columns: minmax(0, 1fr); }
    button { padding-inline: 1rem; }
  }
</style>
