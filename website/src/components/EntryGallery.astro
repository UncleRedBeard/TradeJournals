---
import GalleryViewer from "./GalleryViewer.astro";
const { project } = Astro.props;
// Labels follow the verified photo identities, not an assumed chronological order.
const stages = {
  "flickr-55338112557": "Result — floor renewal, 2025",
  "flickr-55339048056": "Starting condition — first pass, 2024",
  "flickr-55339463385": "Work in progress — first pass, 2024"
};
---

<p class="entry-gallery__intro">These photographs document two separate restoration passes: door, stair and trim work in 2024–25, followed by floor renewal in late 2025. The renewed floor leads this selection; the earlier photographs show protection and finish work around the retained features.</p>
<GalleryViewer project={project} labels={project.gallery.map(image => stages[image.id])} />

<style>
  .entry-gallery__intro { color: #4a4237; line-height: 1.7; max-width: 70ch; margin: -1rem 0 2rem; }
</style>
