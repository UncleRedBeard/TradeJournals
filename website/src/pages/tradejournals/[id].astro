---
import { getEntry, render } from "astro:content";
import EvidenceDetails from "../../components/EvidenceDetails.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import model from "../../generated/site.json";

export function getStaticPaths() {
  return model.projects.map(project => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const story = project.storyId ? await getEntry("stories", project.storyId) : undefined;
const rendered = story ? await render(story) : undefined;
const Story = rendered?.Content;
---

<SiteLayout site={model.site} title={`${project.title} TradeJournal`} reviewNotice={model.reviewNotice}>
  <article class="section"><div class="shell prose">{Story ? <Story /> : <><h1 class="section-heading">{project.title}</h1><p>{project.summary}</p></>}<EvidenceDetails project={project} /><p><a class="button-link" href={project.href}>Return to project</a></p></div></article>
</SiteLayout>
