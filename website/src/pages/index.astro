---
import AtelierContact from "../components/AtelierContact.astro";
import AtelierProjectCard from "../components/AtelierProjectCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/atelier.css";
import model from "@site-model";

const featured = model.home.featuredProjectIds.map(id => model.projects.find(project => project.id === id));
const workshop = model.home.workshopProjectIds.map(id => model.projects.find(project => project.id === id));
const { site, home } = model;
---

<SiteLayout description={`${site.serviceLine} Project records and workshop studies from a craftsman's practice.`} site={site} home={home} reviewNotice={model.reviewNotice} bodyClass="atelier-home">
  <section class="atelier-hero" aria-labelledby="home-heading">
    <div class="atelier-shell atelier-hero__grid">
      <div>
        <p class="atelier-hero__label">Preservation practice for older residences</p>
        <h1 id="home-heading">{home.headline}</h1>
        <p class="atelier-hero__service">{site.serviceLine}</p>
      </div>
      <aside class="atelier-practice" id={model.services.length ? undefined : "practice"} aria-labelledby="practice-heading">
        <h2 class="atelier-eyebrow" id="practice-heading">A craftsman's practice</h2>
        <p>{home.intro}</p>
        <div class="atelier-practice__foot">
          <span>Restoration at home</span>
          {featured[0] && <a href={featured[0].href}>See the work</a>}
        </div>
      </aside>
      <div class="atelier-mobile-contact"><AtelierContact contact={site.contact} /></div>
    </div>
  </section>

  <div class="atelier-shell atelier-main">
    {model.services.length > 0 && (
      <section class="atelier-services" id="practice" aria-labelledby="services-heading">
        <div class="atelier-section-heading">
          <div><p class="atelier-eyebrow">Care for the original</p><h2 id="services-heading">Services and assessment</h2></div>
          <p class="atelier-section-heading__note">Project examples are work in my own home</p>
        </div>
        <div class="atelier-services__grid">
          {model.services.map(service => (
            <div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              {service.projectIds.length > 0 && (
                <ul>
                  {service.projectIds.map(id => {
                    const project = model.projects.find(project => project.id === id);
                    return <li><a href={project.href}>{project.title}</a></li>;
                  })}
                </ul>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <section id="documented-projects" aria-labelledby="projects-heading">
      <div class="atelier-section-heading">
        <div><p class="atelier-eyebrow">Restoration work</p><h2 id="projects-heading">Documented Projects</h2></div>
        <p class="atelier-section-heading__note">Restoration work in my own home</p>
      </div>
      <div class="atelier-projects">
        {featured.map((project, index) => <AtelierProjectCard project={project} eager={index === 0} />)}
      </div>
    </section>

    {workshop.length > 0 && (
      <section class="atelier-workshop" id="workshop-studies" aria-labelledby="workshop-heading">
        <div class="atelier-workshop__surface">
          <div class="atelier-workshop__intro">
            <p class="atelier-eyebrow">Studio studies</p>
            <h2 id="workshop-heading">From the workshop</h2>
            <p>Clay and film sit beside the restoration work as quieter records of practice, observation, and material judgment.</p>
          </div>
          <div class="atelier-workshop__grid">
            {workshop.map(project => <AtelierProjectCard project={project} workshop />)}
          </div>
        </div>
      </section>
    )}
  </div>

</SiteLayout>
