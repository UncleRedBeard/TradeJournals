---
import "../styles/base.css";
import "../styles/atelier-frame.css";
import AtelierHeader from "../components/AtelierHeader.astro";
import AtelierFooter from "../components/AtelierFooter.astro";
import fontLicense from "../styles/fonts/OFL.txt?raw";

const { site, home, title = "", description, reviewNotice = "", bodyClass = "" } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.descriptor}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {reviewNotice && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body class:list={["atelier-site", bodyClass]}>
    <template id="font-license">{fontLicense}</template>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot name="header">
      <AtelierHeader site={site} home={home} isHome={Astro.url.pathname === "/"} />
    </slot>
    {reviewNotice && <aside class="review-notice"><div class="shell">{reviewNotice}</div></aside>}
    <main id="main-content" tabindex="-1"><slot /></main>
    <slot name="footer">
      <AtelierFooter site={site} />
    </slot>
  </body>
</html>
