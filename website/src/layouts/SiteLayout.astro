---
import "../styles/base.css";

const { site, title = "", reviewNotice = "" } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.descriptor}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    {reviewNotice && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell site-header__row">
        <a class="site-name" href="/">
          {site.name}
          <span class="site-descriptor">{site.descriptor}</span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {site.navigation.map(link => <a href={link.href}>{link.label}</a>)}
        </nav>
      </div>
    </header>
    {reviewNotice && <aside class="review-notice"><div class="shell">{reviewNotice}</div></aside>}
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div class="shell"><strong>{site.name}</strong><br />{site.serviceLine}</div></footer>
  </body>
</html>
